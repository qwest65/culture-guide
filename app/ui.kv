#:import OfflineCityMap app.offline_map.OfflineCityMap

BoxLayout:
    orientation: "vertical"
    BoxLayout:
        size_hint_y: None
        height: "58dp"
        padding: "10dp"
        Label:
            text: app.city_name + "\n" + app.city_country
            halign: "left"
            text_size: self.size
            color: 1,1,1,1
            canvas.before:
                Color:
                    rgba: .07,.10,.16,1
                Rectangle:
                    pos: self.pos
                    size: self.size
        Label:
            text: str(app.object_count) + " объектов"
            size_hint_x: None
            width: "90dp"

    BoxLayout:
        size_hint_y: None
        height: "48dp"
        padding: "7dp"
        spacing: "7dp"
        TextInput:
            hint_text: "Поиск"
            multiline: False
            on_text: app.search(self.text)
        Button:
            text: "Маршрут"
            size_hint_x: None
            width: "100dp"
            on_release: app.make_tour()

    BoxLayout:
        padding: "7dp"
        spacing: "7dp"
        BoxLayout:
            orientation: "vertical"
            size_hint_x: .36
            Label:
                text: "Города"
                size_hint_y: None
                height: "32dp"
            RecycleView:
                id: city_list
                viewclass: "CityRow"
            Label:
                text: "Места"
                size_hint_y: None
                height: "32dp"
            RecycleView:
                id: place_list
                viewclass: "PlaceRow"
            Button:
                text: "Добавить город"
                size_hint_y: None
                height: "44dp"
                on_release: app.add_demo_city()
        BoxLayout:
            orientation: "vertical"
            Label:
                text: "Офлайн-карта"
                size_hint_y: None
                height: "30dp"
            OfflineCityMap:
                id: city_map
            Label:
                text: "Схема маршрутов"
                size_hint_y: None
                height: "30dp"
            MetroWidget:
                id: metro
            TextInput:
                id: tour
                readonly: True
                font_size: "11sp"
                size_hint_y: .35

    Label:
        text: app.status_text
        size_hint_y: None
        height: "28dp"

<CityRow>:
    text: root.text
    city_id: ""
    size_hint_y: None
    height: "42dp"
    on_release: app.select_city(root.city_id)

<PlaceRow>:
    text: root.text + "\n" + root.category
    place_id: ""
    size_hint_y: None
    height: "46dp"

<MetroWidget@Widget>:
    canvas:
        Color:
            rgba: .98,.98,.99,1
        Rectangle:
            pos: self.pos
            size: self.size
